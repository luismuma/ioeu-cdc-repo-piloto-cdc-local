EXTRACT {{ extract_name }}

-- DB Connection
USERIDALIAS {{ useridalias }}{% if domain %} DOMAIN {{ domain }}{% endif %}

-- Encryption using local wallet master key
ENCRYPTTRAIL AES256

-- TRAIL NAME
EXTTRAIL {{ trail_path }}

-- Include all columns with supplemental logging
LOGALLSUPCOLS

-- Update record format FULL 
UPDATERECORDFORMAT FULL

-- Capture DDL operations for listed schema tables
DDL INCLUDE MAPPED

-- Add step-by-step history of ddl operations captured to the report file. Very useful when troubleshooting
DDLOPTIONS REPORT

-- Write capture stats per table to the report file daily.
REPORT AT 00:01

-- Rollover the report file weekly
REPORTROLLOVER AT 00:01 ON SUNDAY

-- Report total operations captured, and operations per second
REPORTCOUNT EVERY 5 MINUTES, RATE

-- Defines source OS timezone to ensure accurate timestamp
TRANLOGOPTIONS SOURCE_OS_TIMEZONE Europe/Madrid

{% if sourcecatalog %}
-- Specifies PDB/catalog 
SOURCECATALOG {{ sourcecatalog }}
{% endif %}

-- Tables
{% for line in table_lines %}
{{ line }}
{% endfor %}
