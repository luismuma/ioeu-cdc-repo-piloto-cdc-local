# Catch-all: auto-detect text vs binary, normalize text to LF
* text=auto eol=lf

# --- Source / config / markup (explicit LF) ---
*.py     text eol=lf
*.pyi    text eol=lf
*.yml    text eol=lf
*.yaml   text eol=lf
*.j2     text eol=lf
*.tmpl   text eol=lf
*.json   text eol=lf
*.xml    text eol=lf
*.md     text eol=lf
*.rst    text eol=lf
*.txt    text eol=lf
*.cfg    text eol=lf
*.sql    text eol=lf
*.sh     text eol=lf
*.js     text eol=lf
*.c      text eol=lf
*.h      text eol=lf
*.pem    text eol=lf
*.pth    text eol=lf

# --- Windows-native scripts (keep CRLF on Windows checkout) ---
*.ps1    text eol=crlf
*.bat    text eol=crlf
*.cmd    text eol=crlf

# --- Binary (never convert) ---
*.exe    binary
*.pyd    binary
*.pyc    binary
*.png    binary
*.jpg    binary
*.jpeg   binary
*.gif    binary
*.ico    binary
*.zip    binary
*.gz     binary
*.tar    binary
