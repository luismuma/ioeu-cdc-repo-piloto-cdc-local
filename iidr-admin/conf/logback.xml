<configuration>

  <!--
    IMPORTANTE: los logs van a stderr para no contaminar el stdout JSON
    que lee Ansible. stdout es exclusivamente para el CommandResult.
    El NopStatusListener silencia los mensajes de inicialización del propio
    logback que por defecto se imprimen en stdout antes de leer la config.
  -->
  <statusListener class="ch.qos.logback.core.status.NopStatusListener"/>

  <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
    <target>System.err</target>
    <encoder>
      <pattern>%d{HH:mm:ss.SSS} [%-5level] %logger{36} - %msg%n</pattern>
    </encoder>
  </appender>

  <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
    <file>log/iidr-admin.log</file>
    <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
      <fileNamePattern>log/iidr-admin-%d{yyyy-MM-dd}.log.gz</fileNamePattern>
      <maxHistory>7</maxHistory>
    </rollingPolicy>
    <encoder>
      <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%-5level] %logger{36} - %msg%n</pattern>
    </encoder>
  </appender>

  <!-- Silenciar logs verbosos de las librerías IBM -->
  <logger name="com.ibm" level="WARN"/>

  <root level="INFO">
    <appender-ref ref="CONSOLE"/>
    <appender-ref ref="FILE"/>
  </root>

</configuration>
